{
  "manifest_version": 2,
  "name": "AI 모드 프레임 허용 (개인용)",
  "version": "2.0",
  "description": "AI 모드 프레임 허용(Google·네이버)",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.co.kr/*"
      ],
      "js": ["hide_contents.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}